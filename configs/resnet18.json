{
    "name": "resnet18-benchmark",
    "n_gpu": 4,
    "gpu_number": 0,

    "arch": {
        "type": "buildResNet",
        "args": {"num_layers":  18, "num_classes":  2}
    },
    "data_loader": {
        "type": "MimicPneumoniaDataloader",
        "args":{
            "data_dir": "train.csv",
            "test_dir": "test.csv",
            "batch_size": 64,
            "input_size": 224,
            "shuffle": true,
            "validation_split": 0.1,
            "num_workers": 4
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "cross_entropy",
    "metrics": [
        "accuracy", "precision", "recall", "balanced_accuracy", "f1score", "roc_auc"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 10,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 100,
        "save_dir": "saved/",
        "save_period": 1,
        "verbosity": 2,
        
        "monitor": "max val_roc_auc",
        "early_stop": 20,

        "tensorboard": true
    }
}
